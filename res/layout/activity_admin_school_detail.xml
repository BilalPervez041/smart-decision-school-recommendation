<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/adminDetailCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedBottomCorners" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#40000000" />

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bottom_gradient" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <!-- Marquee for Admission Status -->
                <TextView
                    android:id="@+id/tvMarqueeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="#80000000"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"
                    android:text="Loading Admission Status..." />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAdminLogo"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:cardCornerRadius="45dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3dp">

                    <ImageView
                        android:id="@+id/adminDetailLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_myplaces" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/adminDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:shadowColor="#BF000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="School Name"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="16dp"
                android:background="@drawable/spinner_background"
                android:elevation="10dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/colorPrimary" />

        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- School Identity Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorPrimary"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/adminDetailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Address Details"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="15sp"
                        android:drawablePadding="10dp"
                        android:drawableStart="@android:drawable/ic_menu_directions"
                        app:drawableTint="?android:attr/textColorSecondary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/textColorSecondary"
                        android:alpha="0.2"
                        android:layout_marginVertical="15dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:alignmentMode="alignMargins">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/adminDetailStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Approved" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="School Type" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/adminDetailType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Private" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medium" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/adminDetailMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gender" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/adminDetailGender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Co-education" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="School Level" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/adminDetailLevel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nursery to Inter" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Admissions" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/textAdminAdmissionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Closed" android:textStyle="bold" />
                        </LinearLayout>
                    </GridLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <RatingBar
                            android:id="@+id/adminDetailRatingBar"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressTint="#FFB300"
                            android:rating="0"
                            android:stepSize="0.1" />

                        <TextView
                            android:id="@+id/adminDetailRatingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="(0.0)"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Admission Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdmissionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#10B981"
                app:cardBackgroundColor="?attr/colorSurface"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="#10B981" />

                        <TextView
                            android:id="@+id/detailAdmissionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Admissions Open"
                            android:textColor="#10B981"
                            android:textStyle="bold"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#10B981"
                        android:alpha="0.2"
                        android:layout_marginVertical="15dp" />

                    <TextView
                        android:id="@+id/detailAdmissionLevels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Levels: Nursery, Primary"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:drawablePadding="10dp"
                        android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                        app:drawableTint="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/detailAdmissionDates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Dates: From 01/03/2024 to 30/03/2024"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:drawablePadding="10dp"
                        android:drawableStart="@android:drawable/ic_menu_today"
                        app:drawableTint="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/detailAdmissionSeats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Seats: Boys: 10, Girls: 10"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:drawablePadding="10dp"
                        android:drawableStart="@android:drawable/ic_menu_myplaces"
                        app:drawableTint="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/detailAdmissionFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Admission Fee: 5000 PKR"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Action Buttons -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminEdit"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Edit"
                        android:textSize="10sp"
                        app:icon="@android:drawable/ic_menu_edit"
                        app:iconGravity="top"
                        app:iconSize="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminContact"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Email"
                        android:textSize="10sp"
                        app:icon="@android:drawable/ic_dialog_email"
                        app:iconGravity="top"
                        app:iconSize="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminReviews"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Reviews"
                        android:textSize="10sp"
                        app:icon="@android:drawable/btn_star"
                        app:iconGravity="top"
                        app:iconSize="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminDelete"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Delete"
                        android:textSize="10sp"
                        android:textColor="#D32F2F"
                        app:icon="@android:drawable/ic_menu_delete"
                        app:iconTint="#D32F2F"
                        app:iconGravity="top"
                        app:iconSize="24dp" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Financial Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorPrimary"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Grade-wise Fees"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/adminContainerFees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/textColorSecondary"
                        android:alpha="0.2"
                        android:layout_marginVertical="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facilities \u0026 Contact"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorSecondary" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/adminChipGroupFacilities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp" />

                    <TextView
                        android:id="@+id/adminDetailContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Contact Info"
                        android:drawableStart="@android:drawable/ic_menu_call"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="?android:attr/textColorSecondary"
                        app:drawableTint="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/adminDetailMerit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Merit: 85%"
                        android:drawableStart="@android:drawable/ic_dialog_info"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="?android:attr/textColorSecondary"
                        app:drawableTint="?android:attr/textColorSecondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>