<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedBottomCorners" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#40000000" />

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bottom_gradient" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <!-- Marquee for Admission Status -->
                <TextView
                    android:id="@+id/tvMarqueeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="#80000000"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"
                    android:text="Loading Admission Status..." />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLogo"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:cardCornerRadius="45dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3dp">

                    <ImageView
                        android:id="@+id/detailLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:padding="4dp"
                        android:src="@android:drawable/ic_menu_myplaces" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/detailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:shadowColor="#BF000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="School Name"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <RatingBar
                        android:id="@+id/detailRatingBar"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="0"
                        android:progressTint="#FFD700"
                        android:secondaryProgressTint="#FFD700"
                        android:isIndicator="true" />

                    <TextView
                        android:id="@+id/tvDetailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0.0 (0 reviews)"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="16dp"
                android:background="@drawable/spinner_background"
                android:elevation="10dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/colorPrimary" />

        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorPrimary"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/detailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Address Details"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="15sp"
                        android:drawablePadding="10dp"
                        android:drawableStart="@android:drawable/ic_menu_directions"
                        app:drawableTint="?android:attr/textColorSecondary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/textColorSecondary"
                        android:alpha="0.2"
                        android:layout_marginVertical="15dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:alignmentMode="alignMargins">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fee Structure" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/detailFee" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PKR 5000" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="School Type" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/detailType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Private" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medium" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/detailMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gender" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/detailGender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Co-education" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="School Level" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/detailLevel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nursery to Inter" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Merit Percentage" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/detailMerit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="District" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/detailDistrict" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Abbottabad" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contact Info" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                            <TextView android:id="@+id/detailContact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not Available" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
                        </LinearLayout>
                    </GridLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facilities Available"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="20dp"
                        android:textColor="?attr/colorSecondary" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupFacilities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp" />

                    <View
                        android:id="@+id/feeDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/textColorSecondary"
                        android:alpha="0.2"
                        android:layout_marginVertical="20dp" />

                    <LinearLayout
                        android:id="@+id/headerGradeFees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/labelGradeFees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Grade-wise Fee Structure"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerGradeFees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp" />

                    <!-- Admission Card Added -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAdmissionInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="#10B981"
                        app:cardBackgroundColor="?attr/colorSurface"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@android:drawable/ic_dialog_info"
                                    app:tint="#10B981" />

                                <TextView
                                    android:id="@+id/detailAdmissionStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Admissions Open"
                                    android:textColor="#10B981"
                                    android:textStyle="bold"
                                    android:textSize="17sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#10B981"
                                android:alpha="0.2"
                                android:layout_marginVertical="12dp" />

                            <TextView
                                android:id="@+id/detailAdmissionLevels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Levels: Nursery, Primary"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="14sp"
                                android:drawablePadding="8dp"
                                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                                app:drawableTint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/detailAdmissionDates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Dates: From 01/03/2024 to 30/03/2024"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="14sp"
                                android:drawablePadding="8dp"
                                android:drawableStart="@android:drawable/ic_menu_today"
                                app:drawableTint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/detailAdmissionSeats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Seats: Boys Seats: 10 Girls Seats: 10"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="14sp"
                                android:drawablePadding="8dp"
                                android:drawableStart="@android:drawable/ic_menu_myplaces"
                                app:drawableTint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/detailAdmissionFee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Admission Fee: 5000 PKR"
                                android:textColor="#10B981"
                                android:textStyle="bold"
                                android:textSize="16sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorPrimary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_directions"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location &amp; Directions"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to open in Google Maps"
                            android:textSize="14sp"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="?android:attr/textColorSecondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyAdmission"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Admission"
                    app:cornerRadius="15dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#4CAF50"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="textStart"
                    app:elevation="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReviews"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Reviews"
                    app:cornerRadius="15dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorSecondary"
                    app:icon="@android:drawable/btn_star"
                    app:iconGravity="textStart"
                    app:elevation="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
